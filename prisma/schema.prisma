// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  OWNER
  ADMIN
  TECHNICIAN
}

// Which testing tool a job/register/template belongs to. Add new values
// here as new tools are introduced.
enum ToolType {
  EXIT_EMERGENCY_LIGHTING
  RCD_TESTING
}

enum FittingType {
  EXIT_SIGN
  EMERGENCY_LIGHT
  COMBINED
}

// Exit & Emergency Lighting job cadence (AS/NZS 2293).
enum TestType {
  SIX_MONTHLY_DISCHARGE
  ANNUAL_FULL_TEST
}

// RCD/safety switch job cadence — interval depends on the site's risk
// classification.
enum RcdTestFrequency {
  SIX_MONTHLY
  TWELVE_MONTHLY
}

enum RcdType {
  TYPE_AC
  TYPE_A
  TYPE_B
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

// Guided walkthrough for an Exit & Emergency Lighting discharge test job.
// Unused (stays at its default) for RCD_TESTING jobs.
enum DischargePhase {
  ENERGISED_CHECK // walking through confirming every fitting is illuminated before starting
  DISCHARGE_TEST // the 90-minute discharge timer is running (or paused)
  REVIEW // timer finished/ended, confirming which fittings failed
  DONE // reviewed and confirmed
}

// Shared pass/fail/needs-repair outcome used by every tool's test result.
enum ResultStatus {
  PASS
  FAIL
  NEEDS_REPAIR
}

// A partially-completed signup, captured step by step as the visitor moves
// through the signup wizard. Deleted when the signup completes, so what
// remains is exactly the list of people who started but didn't finish —
// shown in the platform console so the owner can follow them up.
model SignupLead {
  id           String   @id @default(cuid())
  email        String   @unique
  firstName    String?
  lastName     String?
  mobile       String?
  businessName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A tenant business (e.g. an electrical contracting company) using this system.
model Business {
  id         String   @id @default(cuid())
  name       String
  logoPath   String?
  email      String?
  phone      String?
  address    String?
  recNumber  String? // Registered Electrical Contractor / license number
  abn        String?
  suspended  Boolean  @default(false) // platform admin switch: suspended businesses can't sign in or use the app
  // Set when the post-signup onboarding wizard is finished; null routes the
  // business to /onboarding before they can use the app. Backfilled to
  // createdAt for businesses that predate onboarding.
  onboardedAt DateTime?
  // True while the explore-the-app demo dataset (customer/site/fittings/
  // jobs) is loaded — shows the "clear demo data" bar across the app.
  demoData   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users         User[]
  customers     Customer[]
  sites         Site[]
  jobs          Job[]
  templates     ReportTemplate[]
  fittingModels FittingModel[]
}

model User {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TECHNICIAN)
  // Platform-level super admin: manages all tenant businesses and the shared
  // device catalogue via /admin. Granted to the first account created on an
  // install (whoever deploys the platform owns it); Role stays the
  // within-business permission level.
  isPlatformAdmin Boolean @default(false)
  createdAt    DateTime @default(now())

  jobs Job[] @relation("TechnicianJobs")

  @@index([businessId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?
  // Part of the explore-the-app demo dataset. Deleting demo customers
  // cascades to their sites, fittings, RCD units, jobs and results, so this
  // one flag is enough to wipe the whole demo.
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())

  sites               Site[]
  templateAssignments CustomerReportTemplate[]

  @@index([businessId])
}

// A physical site/premises belonging to a customer, containing fittings/RCDs to be tested.
model Site {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name       String
  address    String?
  mapPdfPath String? // uploaded site/floor plan PDF
  notes      String?
  createdAt  DateTime @default(now())

  // Asked when the site is created: does it already have its own fitting
  // labeling convention (leave reference blank for the tech to fill in), or
  // should new fittings get an auto-suggested reference (see
  // src/lib/naming.ts)? Null = not yet asked (sites created before this
  // existed) — treated the same as an existing convention.
  autoNaming Boolean?

  fittings Fitting[]
  rcdUnits RcdUnit[]
  jobs     Job[]

  @@index([businessId])
  @@index([customerId])
}

// A persistent record of a single exit sign / emergency light fitting at a site.
// Test results accumulate against this fitting across multiple job visits.
model Fitting {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  reference   String // short ID/label, e.g. "EL-01"
  location    String // description, e.g. "Level 1 corridor near stairwell"
  fittingType FittingType @default(EMERGENCY_LIGHT)
  photoPath   String? // reference photo showing the fitting's location
  active      Boolean     @default(true) // false = decommissioned/removed
  createdAt   DateTime    @default(now())

  modelId       String? // catalog entry (brand/model) this physical device is, if selected
  model         FittingModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  installedDate DateTime? // when the device was installed, if known

  testResults FittingTestResult[]

  @@index([siteId])
  @@index([modelId])
}

// A brand/model catalog entry for exit signs & emergency lights, used to
// pick the exact device when adding a fitting (with a reference photo so a
// technician can visually confirm it, without needing to know model numbers
// by heart). businessId null = shared across every business (a starter set
// of common AS/NZS brands); set = a business's own custom addition, visible
// only to them.
model FittingModel {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  brand       String
  model       String
  fittingType FittingType
  photoPath   String? // reference photo of the physical device, shown in the picker
  createdAt   DateTime @default(now())

  fittings Fitting[]

  @@index([businessId])
  @@index([fittingType])
}

// A persistent record of a single RCD (safety switch) at a site, usually at
// a switchboard. Test results accumulate against it across job visits.
model RcdUnit {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  reference       String // short ID/label, e.g. "SB1-RCD2"
  location        String // description, e.g. "Main switchboard, kitchen circuit"
  rcdType         RcdType @default(TYPE_A)
  ratedCurrentMa  Int     @default(30)
  photoPath       String? // reference photo showing the RCD's location
  active          Boolean  @default(true) // false = decommissioned/removed
  createdAt       DateTime @default(now())

  testResults RcdTestResult[]

  @@index([siteId])
}

// A single testing visit/job at a site, for one tool.
model Job {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  technicianId String?
  technician   User?   @relation("TechnicianJobs", fields: [technicianId], references: [id], onDelete: SetNull)

  toolType         ToolType          @default(EXIT_EMERGENCY_LIGHTING)
  testType         TestType? // set when toolType = EXIT_EMERGENCY_LIGHTING
  rcdTestFrequency RcdTestFrequency? // set when toolType = RCD_TESTING
  status           JobStatus         @default(SCHEDULED)
  scheduledDate    DateTime?
  completedDate    DateTime?
  notes            String?
  createdAt        DateTime          @default(now())

  // Discharge test walkthrough state (Exit & Emergency Lighting jobs only).
  dischargePhase          DischargePhase @default(ENERGISED_CHECK)
  dischargeRunningSince   DateTime? // set while the 90-min timer is actively counting down; null when paused/not started
  dischargeElapsedSeconds Int            @default(0) // accumulated elapsed time across pause/resume segments

  fittingTestResults FittingTestResult[]
  rcdTestResults     RcdTestResult[]

  @@index([businessId])
  @@index([siteId])
}

// The result of testing one fitting during one job visit.
model FittingTestResult {
  id        String  @id @default(cuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fittingId String
  fitting   Fitting @relation(fields: [fittingId], references: [id], onDelete: Cascade)

  beforePhotoPath String?
  afterPhotoPath  String?

  energisedPass         Boolean? // pre-test walkthrough: is the fitting illuminated/powered
  durationTestPass      Boolean? // 90 min discharge test
  illuminationPass      Boolean?
  batteryConditionPass  Boolean?
  lampConditionPass     Boolean?
  physicalDamagePass    Boolean?
  signageVisiblePass    Boolean?

  overallResult ResultStatus @default(PASS)
  comments      String?
  repairNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([fittingId])
  @@unique([jobId, fittingId])
}

// The result of testing one RCD during one job visit.
model RcdTestResult {
  id        String  @id @default(cuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rcdUnitId String
  rcdUnit   RcdUnit @relation(fields: [rcdUnitId], references: [id], onDelete: Cascade)

  beforePhotoPath String?
  afterPhotoPath  String?

  testButtonPass  Boolean? // push-button (T) test trips the RCD
  tripTimeRatedMs Int? // trip time at 1x rated residual current, milliseconds
  tripTime5xMs    Int? // trip time at 5x rated residual current, milliseconds

  overallResult ResultStatus @default(PASS)
  comments      String?
  repairNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([rcdUnitId])
  @@unique([jobId, rcdUnitId])
}

// A configurable PDF report layout for one tool, owned by a business.
// Reports resolve to a customer's assigned template for that tool, falling
// back to the business's default template, falling back to a built-in look.
model ReportTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  toolType  ToolType
  name      String
  isDefault Boolean  @default(false)

  // Layout/style
  accentColor   String  @default("#1d4ed8")
  showStatCards Boolean @default(true)
  showPhotos    Boolean @default(true)
  // Ordered list of column keys to show in the results table — the set of
  // valid keys is tool-specific and validated in application code.
  tableColumns  Json

  // Custom text/branding blocks
  headerText     String?
  footerText     String?
  disclaimerText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerAssignments CustomerReportTemplate[]

  @@index([businessId])
  @@index([businessId, toolType])
}

// Assigns a specific template to a customer, per tool. Absent = use the
// business's default template for that tool.
model CustomerReportTemplate {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  toolType   ToolType
  templateId String
  template   ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([customerId, toolType])
  @@index([templateId])
}
